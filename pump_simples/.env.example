# ============================================================
#  robozão — configuração (.env)
#  Copia este ficheiro para ".env" e preenche os valores.
#      cp .env.example .env
#  O ficheiro .env está no .gitignore — NUNCA é commitado.
# ============================================================

# ------------------------------------------------------------
#  SEGURANÇA / MODO DE EXECUÇÃO
# ------------------------------------------------------------
# DRY_RUN=true  -> simulado, NENHUMA transação real é enviada (default).
# DRY_RUN=false -> permite modo real, MAS ainda precisa da 2ª trava abaixo.
DRY_RUN=true

# 2ª trava. Só quando DRY_RUN=false E PERMITIR_ENVIO_REAL=true é que
# alguma transação real acontece. Mantém em false até teres a certeza.
PERMITIR_ENVIO_REAL=false

# ------------------------------------------------------------
#  CARTEIRA  (a MESMA wallet do bot anterior)
# ------------------------------------------------------------
# Cola aqui a chave privada em base58 (formato Phantom).
# >>> COLA O VALOR TU MESMO. Nunca é impressa nem logada pelo bot. <<<
# Sem aspas. Ex: WALLET_PRIVATE_KEY=4xY....
WALLET_PRIVATE_KEY=

# RPC Solana (mesma SOLANA_RPC_URL do bot anterior — Helius).
# Necessária para o check de segurança das autoridades (fail-closed).
#
# Se a Helius ficar sem créditos, podes usar uma RPC pública GRÁTIS (sem chave):
#   SOLANA_RPC_URL=https://solana-rpc.publicnode.com      (recomendada)
#   SOLANA_RPC_URL=https://api.mainnet-beta.solana.com    (oficial, mais lenta)
# As públicas têm rate-limit apertado — o bot já limita os pedidos (ver abaixo).
SOLANA_RPC_URL=

# ------------------------------------------------------------
#  FONTE DE DETEÇÃO  (só UMA ativa de cada vez)
# ------------------------------------------------------------
# Escolhe de onde vêm os tokens novos. O resto do bot funciona igual
# independentemente da fonte (mesmo formato de dados).
#   gecko               -> GeckoTerminal /new_pools  (default, grátis, sem chave)
#   pumpfun_nao_oficial -> API não-oficial do pump.fun (grátis, sem chave;
#                          engenharia reversa, pode partir se o pump.fun mudar)
#   bitquery            -> Bitquery GraphQL (grátis, precisa de BITQUERY_API_KEY)
FONTE_DETECCAO=gecko

# Só necessária se FONTE_DETECCAO=bitquery.
# Cadastro grátis (100k pontos/mês) em https://bitquery.io -> cria uma API key/token.
BITQUERY_API_KEY=

# ------------------------------------------------------------
#  REGRAS DE ENTRADA
# ------------------------------------------------------------
# Subido de 1000 -> 10000: tokens com pouca liquidez (~$5k) rugam e enchem a -99%.
# Editável ao vivo no dashboard (liquidez mín $). Usa o diagnostico secção 8 p/ afinar.
LIQUIDEZ_MINIMA_USD=10000
# Market cap mínimo à entrada (mcap ≈ preço * 1e9 no pump.fun). 0 = desligado.
# Os dados mostraram que tokens comprados a mcap baixo (~$3k) rugam; os que
# sobem entraram a ~$20k. Filtra os "cedo demais".
MARKETCAP_MINIMO_USD=10000

# Canal HYPE (toggle no dashboard). Quando ligado, compra também tokens com tração
# real (compradores/volume) que saltam o filtro de mcap — MAS mantém liquidez e
# segurança. Limites escolhidos pelos dados (100+ compradores tendia a perder).
HYPE_ATIVO=false
HYPE_MIN_COMPRADORES=40
HYPE_MIN_VOLUME_USD=10000

# LISTA DE VIGIA: tokens rejeitados só por liquidez/mcap baixos continuam a ser
# reavaliados (dados frescos) por este tempo, e comprados se crescerem o
# suficiente — em vez de serem descartados para sempre ao sair do feed new_pools
# (~1min de idade). Resolve "não tem compras" sem baixar os filtros.
VIGIA_TTL_MINUTOS=60
VIGIA_MAX_POR_CICLO=15

# ------------------------------------------------------------
#  REGRAS DE SAÍDA
# ------------------------------------------------------------
# Take-profit fixo. 0 = SEM meta para cima: deixa o pico correr e só o trailing
# gere a subida (é a estratégia atual). Podes na mesma pôr uma meta por posição
# no dashboard. Mete um valor (ex: 50) se quiseres um teto de lucro global.
TAKE_PROFIT_PCT=0
# TRAILING STOP: vende se cair X% desde o PICO mais alto atingido (não desde a compra).
# É a saída principal na subida/descida. Quando o token nunca sobe, age como stop.
TRAILING_STOP_PCT=30
# ESCALONADO: acima de TRAILING_APERTO_ACIMA_PCT de ganho no pico, usa um trailing
# mais apertado — dar 30% de um pico de +500% dói muito mais em valor absoluto do
# que 30% de um pico de +20%.
TRAILING_STOP_APERTADO_PCT=15
TRAILING_APERTO_ACIMA_PCT=100
# STOP_LOSS_PCT é LEGADO — já não é usado (substituído pelo trailing). Mantido só
# para não partir .env antigos.
STOP_LOSS_PCT=25
# Timeout de segurança para tokens que NÃO se mexem. 0 = SEM timeout.
# Subido de 10 -> 20: dados mostraram 97% dos timeouts a subir depois de vender.
TIMEOUT_MINUTOS=20
# ...mas posições cujo PICO já passou esta % ficam ISENTAS do timeout (viram
# "runners", geridas só pelo trailing). Ex: 50 => acima de +50% deixa correr.
# 0 = timeout aplica-se a todas.
TIMEOUT_ISENTO_ACIMA_PCT=50
# Verificação das posições (stop-loss/take-profit). Mais baixo = reage mais depressa
# a quedas rápidas dos tokens pump.fun. 5s é um bom compromisso.
INTERVALO_VERIFICACAO_SEGUNDOS=5

# ------------------------------------------------------------
#  TAMANHO / SALDOS
# ------------------------------------------------------------
MAX_TRADE_USD=2
SALDO_VIRTUAL_INICIAL=1000
# Slippage estimado por lado (SÓ DRY_RUN) — torna o P/L simulado mais realista.
# Aplica-se na compra e na venda. Sobe este valor para simular execução pior.
SLIPPAGE_SIMULADO_PCT=3
# Nº máximo de posições abertas em simultâneo. 0 = SEM limite (o bot compra toda
# a oportunidade que passe as regras; fica limitado só pelo saldo / MAX_TRADE_USD).
MAX_POSICOES_ABERTAS=0
# Símbolo mostrado no saldo/P&L da carteira simulada (€, $, etc.). Ver README (Moeda).
MOEDA_SIMBOLO=€

# ------------------------------------------------------------
#  ROBUSTEZ
# ------------------------------------------------------------
# Máx. de pedidos RPC por segundo (evita rate limit).
RPC_MAX_REQ_POR_SEGUNDO=5
# Máx. de pedidos por segundo à GeckoTerminal (free-tier ~30/min). Baixa se vires 429.
GECKO_MAX_REQ_POR_SEGUNDO=2
# Frequência da procura de tokens novos na GeckoTerminal.
INTERVALO_SCAN_SEGUNDOS=20
# Slippage para swaps Jupiter (só modo real). 500 = 5%.
SLIPPAGE_BPS=500

# ------------------------------------------------------------
#  ACOMPANHAMENTO PÓS-VENDA  (só leitura de preço, nunca faz trades)
# ------------------------------------------------------------
# Quantos tokens já vendidos continuam a ser seguidos no histórico.
ACOMPANHAR_VENDIDOS_MAX=20
# De quanto em quanto tempo reavaliar o preço deles (segundos).
INTERVALO_ACOMPANHAR_VENDIDOS_SEGUNDOS=60

# ------------------------------------------------------------
#  PROTEÇÃO CONTRA COLAPSO DE LIQUIDEZ
# ------------------------------------------------------------
# Se a liquidez cair esta % (ou mais) desde a COMPRA, vende imediatamente,
# ignorando take-profit/trailing/timeout — o preço de uma pool quase sem
# liquidez não é fiável (pode não haver ninguém do outro lado para negociar).
# Motivo no log: "liquidez_colapsou". 0 = desligado.
LIQUIDEZ_QUEDA_VENDA_PCT=70

# ------------------------------------------------------------
#  BLOQUEIO DE MOEDAS QUE JÁ RUGARAM
# ------------------------------------------------------------
# Se um mint já fechou com prejuízo >= esta % (ou por colapso de liquidez),
# fica bloqueado — o bot não volta a comprá-lo. Evita repetir a mesma perda.
BLACKLIST_PREJUIZO_PCT=50
# 0 = bloqueio PERMANENTE. Um valor > 0 = cooldown em horas (volta a poder
# comprar depois disso).
BLACKLIST_COOLDOWN_HORAS=0

# ------------------------------------------------------------
#  NOTIFICAÇÕES TELEGRAM (resumo periódico — pensado p/ correr sem supervisão)
# ------------------------------------------------------------
# Configuração (1 minuto, ver README ou corre `python telegram_setup.py`):
#   1. No Telegram, fala com @BotFather, /newbot, copia o TOKEN.
#   2. Manda uma mensagem qualquer ao teu bot novo.
#   3. python telegram_setup.py <TOKEN>  -> dá-te o CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# De quanto em quanto tempo enviar o resumo (minutos). 0 = desligado.
RESUMO_INTERVALO_MINUTOS=60

# ------------------------------------------------------------
#  DASHBOARD
# ------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
